<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_ProductInfo" width="1050" height="648" titletext="Product Info" background="#f0f1f3" onload="Form_onload">
    <Layouts>
      <Layout height="648" width="1050">
        <Static id="sta_bg" taborder="20" left="24" top="16" right="24" bottom="16" background="#ffffff" borderRadius="8px"/>
        <Button id="btn_back" taborder="0" text="‹  Back to Inventory" left="40" top="24" width="150" height="24" background="transparent" color="#858d9d" border="0px none" textAlign="left" font="12px &quot;Segoe UI&quot;" onclick="btn_back_onclick"/>
        <Static id="sta_title" taborder="21" text="Loading..." left="40" top="48" width="560" height="36" color="#383e49" font="600 20px &quot;Segoe UI&quot;"/>
        <Button id="btn_edit" taborder="1" text="Edit" right="150" top="46" width="90" height="36" icon="url('imagerc::kanban/ic_edit.png')" textPadding="0px 0px 0px 6px" background="#ffffff" color="#48505e" borderRadius="4px" border="1px solid #d0d5dd" font="600 13px &quot;Segoe UI&quot;" onclick="btn_edit_onclick"/>
        <Button id="btn_download" taborder="2" text="Download" right="40" top="46" width="100" height="36" background="#ffffff" color="#48505e" borderRadius="4px" border="1px solid #d0d5dd" font="600 13px &quot;Segoe UI&quot;" onclick="btn_download_onclick"/>
        <Button id="btn_tab_overview" taborder="3" text="Overview" left="40" top="92" width="96" height="36" background="transparent" border="0px none" color="#1a5fd9" font="600 14px &quot;Segoe UI&quot;" onclick="btn_tab_onclick"/>
        <Button id="btn_tab_purchase" taborder="4" text="Purchases" left="136" top="92" width="104" height="36" background="transparent" border="0px none" color="#5d6679" font="14px &quot;Segoe UI&quot;" onclick="btn_tab_onclick"/>
        <Button id="btn_tab_adjust" taborder="5" text="Adjustments" left="240" top="92" width="116" height="36" background="transparent" border="0px none" color="#5d6679" font="14px &quot;Segoe UI&quot;" onclick="btn_tab_onclick"/>
        <Button id="btn_tab_history" taborder="6" text="History" left="356" top="92" width="88" height="36" background="transparent" border="0px none" color="#5d6679" font="14px &quot;Segoe UI&quot;" onclick="btn_tab_onclick"/>
        <Static id="sta_tab_line" taborder="22" left="40" top="128" right="40" height="1" background="#e4e7ec"/>
        <Static id="sta_tab_mark" taborder="23" left="40" top="127" width="96" height="2" background="#1a5fd9"/>
        <Div id="div_overview" taborder="7" left="40" top="132" right="40" bottom="28" border="0px none">
          <Layouts>
            <Layout>
              <Static id="sta_h_primary" taborder="0" text="Primary Details" left="0" top="12" width="300" height="28" color="#383e49" font="600 15px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_name" taborder="1" text="Product name" left="0" top="48" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_name" taborder="2" text="-" left="190" top="48" width="360" height="26" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_code" taborder="3" text="Product ID" left="0" top="82" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_code" taborder="4" text="-" left="190" top="82" width="360" height="26" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_category" taborder="5" text="Product category" left="0" top="116" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_category" taborder="6" text="-" left="190" top="116" width="360" height="26" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_expiry" taborder="7" text="Expiry Date" left="0" top="150" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_expiry" taborder="8" text="-" left="190" top="150" width="360" height="26" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_threshold" taborder="9" text="Threshold Value" left="0" top="184" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_threshold" taborder="10" text="-" left="190" top="184" width="360" height="26" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_h_supplier" taborder="11" text="Supplier Details" left="0" top="224" width="300" height="28" color="#383e49" font="600 15px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_supplier" taborder="12" text="Supplier name" left="0" top="260" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_supplier" taborder="13" text="-" left="190" top="260" width="360" height="26" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_contact" taborder="14" text="Contact Number" left="0" top="294" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_contact" taborder="15" text="-" left="190" top="294" width="360" height="26" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_h_stock" taborder="16" text="Stock Locations" left="0" top="334" width="300" height="28" color="#383e49" font="600 15px &quot;Segoe UI&quot;"/>
              <Grid id="grd_stock" taborder="17" left="0" top="368" width="560" bottom="0" autofittype="col" border="0px none" selecttype="row">
                <Formats>
                  <Format id="default">
                    <Columns>
                      <Column size="380"/>
                      <Column size="180"/>
                    </Columns>
                    <Rows>
                      <Row size="36" band="head"/>
                      <Row size="38"/>
                    </Rows>
                    <Band id="head">
                      <Cell text="Store Name" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="1" text="Stock in hand" textAlign="right" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                    </Band>
                    <Band id="body">
                      <Cell text="bind:LOCATION_NAME" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="1" text="bind:QUANTITY" textAlign="right" background="#ffffff" color="#1a5fd9" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
              <ImageViewer id="img_photo" taborder="18" left="700" top="12" width="150" height="150" stretch="fixaspectratio" border="1px dashed #98a2b3" borderRadius="4px" background="#ffffff"/>
              <Static id="sta_noimage" taborder="19" text="No image" left="700" top="12" width="150" height="150" textAlign="center" color="#98a2b3" font="12px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_opening" taborder="20" text="Opening Stock" left="640" top="190" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_opening" taborder="21" text="-" right="0" top="190" width="120" height="26" textAlign="right" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_remaining" taborder="22" text="Remaining Stock" left="640" top="224" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_remaining" taborder="23" text="-" right="0" top="224" width="120" height="26" textAlign="right" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_ontheway" taborder="24" text="On the way" left="640" top="258" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_ontheway" taborder="25" text="-" right="0" top="258" width="120" height="26" textAlign="right" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_threshold2" taborder="26" text="Threshold value" left="640" top="292" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_threshold2" taborder="27" text="-" right="0" top="292" width="120" height="26" textAlign="right" color="#383e49" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_availability" taborder="28" text="Availability" left="640" top="326" width="180" height="26" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_availability" taborder="29" text="-" right="0" top="326" width="120" height="26" textAlign="right" color="#383e49" font="600 13px &quot;Segoe UI&quot;"/>
            </Layout>
          </Layouts>
        </Div>
        <Div id="div_purchase" taborder="8" visible="false" left="40" top="132" right="40" bottom="28" border="0px none">
          <Layouts>
            <Layout>
              <Grid id="grd_movement" taborder="0" left="0" top="12" right="0" bottom="0" autofittype="col" border="0px none" selecttype="row">
                <Formats>
                  <Format id="default">
                    <Columns>
                      <Column size="160"/>
                      <Column size="110"/>
                      <Column size="130"/>
                      <Column size="280"/>
                      <Column size="150"/>
                    </Columns>
                    <Rows>
                      <Row size="36" band="head"/>
                      <Row size="38"/>
                    </Rows>
                    <Band id="head">
                      <Cell text="Date" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="1" text="Quantity" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="2" text="Unit price" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="3" text="Note" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="4" text="By" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                    </Band>
                    <Band id="body">
                      <Cell text="bind:DATE_TEXT" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="1" text="bind:QTY_TEXT" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="2" text="bind:PRICE_TEXT" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="3" text="bind:NOTE" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="4" text="bind:USER_NAME" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
              <Static id="sta_nodata" taborder="1" visible="false" text="Nothing recorded yet." left="0" top="80" right="0" height="40" textAlign="center" color="#858d9d" font="14px &quot;Segoe UI&quot;"/>
            </Layout>
          </Layouts>
        </Div>
        <Div id="div_adjust" taborder="9" visible="false" left="40" top="132" right="40" bottom="28" border="0px none">
          <Layouts>
            <Layout>
              <Grid id="grd_movement" taborder="0" left="0" top="12" right="0" bottom="0" autofittype="col" border="0px none" selecttype="row">
                <Formats>
                  <Format id="default">
                    <Columns>
                      <Column size="160"/>
                      <Column size="110"/>
                      <Column size="130"/>
                      <Column size="280"/>
                      <Column size="150"/>
                    </Columns>
                    <Rows>
                      <Row size="36" band="head"/>
                      <Row size="38"/>
                    </Rows>
                    <Band id="head">
                      <Cell text="Date" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="1" text="Quantity" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="2" text="Unit price" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="3" text="Note" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="4" text="By" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                    </Band>
                    <Band id="body">
                      <Cell text="bind:DATE_TEXT" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="1" text="bind:QTY_TEXT" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="2" text="bind:PRICE_TEXT" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="3" text="bind:NOTE" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="4" text="bind:USER_NAME" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
              <Static id="sta_nodata" taborder="1" visible="false" text="Nothing recorded yet." left="0" top="80" right="0" height="40" textAlign="center" color="#858d9d" font="14px &quot;Segoe UI&quot;"/>
            </Layout>
          </Layouts>
        </Div>
        <Div id="div_history" taborder="10" visible="false" left="40" top="132" right="40" bottom="28" border="0px none">
          <Layouts>
            <Layout>
              <Grid id="grd_movement" taborder="0" left="0" top="12" right="0" bottom="0" autofittype="col" border="0px none" selecttype="row">
                <Formats>
                  <Format id="default">
                    <Columns>
                      <Column size="150"/>
                      <Column size="110"/>
                      <Column size="100"/>
                      <Column size="120"/>
                      <Column size="250"/>
                      <Column size="140"/>
                    </Columns>
                    <Rows>
                      <Row size="36" band="head"/>
                      <Row size="38"/>
                    </Rows>
                    <Band id="head">
                      <Cell text="Date" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="1" text="Type" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="2" text="Quantity" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="3" text="Unit price" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="4" text="Note" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                      <Cell col="5" text="By" textAlign="left" background="#f0f1f3" color="#667085" font="600 12px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none"/>
                    </Band>
                    <Band id="body">
                      <Cell text="bind:DATE_TEXT" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="1" text="bind:TYPE_NAME" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="2" text="bind:QTY_TEXT" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="3" text="bind:PRICE_TEXT" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="4" text="bind:NOTE" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                      <Cell col="5" text="bind:USER_NAME" textAlign="left" background="#ffffff" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 12px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
              <Static id="sta_nodata" taborder="1" visible="false" text="Nothing recorded yet." left="0" top="80" right="0" height="40" textAlign="center" color="#858d9d" font="14px &quot;Segoe UI&quot;"/>
            </Layout>
          </Layouts>
        </Div>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_cond">
        <ColumnInfo>
          <Column id="PRODUCT_ID" type="STRING" size="20"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="ds_product"/>
      <Dataset id="ds_stock"/>
      <Dataset id="ds_movement"/>
      <Dataset id="ds_purchase"/>
      <Dataset id="ds_adjust"/>
    </Objects>
    <Script type="xscript5.1"><![CDATA[include "Lib::Lib_Comm.xjs";

this.fv_oTab = null;

this.Form_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	// grids in the page Divs are bound by script: the datasets live in this form
	this.div_overview.form.grd_stock.set_binddataset(this.ds_stock);
	this.div_purchase.form.grd_movement.set_binddataset(this.ds_purchase);
	this.div_adjust.form.grd_movement.set_binddataset(this.ds_adjust);
	this.div_history.form.grd_movement.set_binddataset(this.ds_movement);

	this.fv_oTab = this.btn_tab_overview;
	this.fn_searchDetail();
};

// product with its supplier (ds_product), stock per location (ds_stock), every stock movement (ds_movement)
this.fn_searchDetail = function()
{
	var oLayout = this.parent.parent;
	var sProductId = (oLayout && oLayout.fv_sProductId) ? oLayout.fv_sProductId : "1";
	this.ds_cond.setColumn(0, "PRODUCT_ID", sProductId);

    var sSvcID    = "svcProductDetail";
    var sURL      = "KanbanUrl::product/detail";
    var sInDs     = "ds_cond=ds_cond";
    var sOutDs    = "ds_product=ds_product ds_stock=ds_stock ds_movement=ds_movement";
    var sParam    = "";
    var sCallBack = "fn_callback";
	this.gfn_transaction(sSvcID, sURL, sInDs, sOutDs, sParam, sCallBack);
};

this.fn_callback = function(svcId, errCd, errMsg)
{
	if(errCd < 0){
		this.gfn_alert("msg.err.validator", [errMsg]);
		return;
	}

	if(svcId == "svcProductDetail"){
		this.fn_showProduct();
		this.fn_showMovement();
		// no row is selected at first in the read-only grids
		this.ds_stock.set_rowposition(-1);
		this.ds_movement.set_rowposition(-1);
		this.ds_purchase.set_rowposition(-1);
		this.ds_adjust.set_rowposition(-1);
	}
};

// value of ds_product, "-" when it is empty
this.fn_getValue = function(sColId)
{
	var sValue = this.ds_product.getColumn(0, sColId);
	return this.gfn_isNull(sValue) ? "-" : String(sValue);
};

// yyyyMMdd -> d/M/yy (13/4/23)
this.fn_formatDate = function(sDate)
{
	if(this.gfn_isNull(sDate) || String(sDate).length < 8) return "-";
	sDate = String(sDate);
	return parseInt(sDate.substr(6, 2), 10) + "/" + parseInt(sDate.substr(4, 2), 10) + "/" + sDate.substr(2, 2);
};

// yyyyMMddHHmmss -> dd/MM/yyyy HH:mm
this.fn_formatDateTime = function(sDate)
{
	if(this.gfn_isNull(sDate) || String(sDate).length < 12) return "";
	sDate = String(sDate);
	return sDate.substr(6, 2) + "/" + sDate.substr(4, 2) + "/" + sDate.substr(0, 4) + " " + sDate.substr(8, 2) + ":" + sDate.substr(10, 2);
};

this.fn_showProduct = function()
{
	var oOverview = this.div_overview.form;

	this.sta_title.set_text(this.fn_getValue("PRODUCT_NAME"));

	// Primary Details
	oOverview.sta_name.set_text(this.fn_getValue("PRODUCT_NAME"));
	oOverview.sta_code.set_text(this.fn_getValue("PRODUCT_CODE"));
	oOverview.sta_category.set_text(this.fn_getValue("CATEGORY_NAME"));
	oOverview.sta_expiry.set_text(this.fn_formatDate(this.ds_product.getColumn(0, "EXPIRY_DATE")));
	oOverview.sta_threshold.set_text(this.fn_getValue("THRESHOLD_VALUE"));

	// Supplier Details
	var bSupplier = !this.gfn_isNull(this.ds_product.getColumn(0, "SUPPLIER_NAME"));
	oOverview.sta_supplier.set_text(bSupplier ? this.fn_getValue("SUPPLIER_NAME") : "No supplier for this product yet");
	oOverview.sta_contact.set_text(this.fn_getValue("SUPPLIER_CONTACT"));

	// stock figures on the right
	oOverview.sta_opening.set_text(this.fn_getValue("PURCHASED_QTY"));
	oOverview.sta_remaining.set_text(this.fn_getValue("QUANTITY"));
	oOverview.sta_ontheway.set_text(this.fn_getValue("ON_THE_WAY"));
	oOverview.sta_threshold2.set_text(this.fn_getValue("THRESHOLD_VALUE"));
	this.fn_showAvailability();

	// IMAGE_DATA is the path returned by file/upload ("file/<name>")
	var sImage = this.ds_product.getColumn(0, "IMAGE_DATA");
	oOverview.sta_noimage.set_visible(this.gfn_isNull(sImage));
	oOverview.img_photo.set_image(this.gfn_isNull(sImage) ? "" : "url('" + nexacro.getEnvironment().services["KanbanUrl"].url + sImage + "')");
};

this.fn_showAvailability = function()
{
	var sCode  = this.ds_product.getColumn(0, "AVAILABILITY");
	var sColor = {IN : "#10a760", LOW : "#e19133", OUT : "#da3e33"}[sCode] || "#667085";
	this.div_overview.form.sta_availability.set_text(this.fn_getValue("AVAILABILITY_NAME"));
	this.div_overview.form.sta_availability.set_color(sColor);
};

// adds the display columns, then fills the Purchases / Adjustments copies
this.fn_showMovement = function()
{
	var objDs = this.ds_movement;
	objDs.set_enableevent(false);
	objDs.addColumn("DATE_TEXT" , "STRING");
	objDs.addColumn("TYPE_NAME" , "STRING");
	objDs.addColumn("QTY_TEXT"  , "STRING");
	objDs.addColumn("PRICE_TEXT", "STRING");
	for(var i=0; i<objDs.rowcount; i++){
		var nQty   = parseInt(objDs.getColumn(i, "QUANTITY"), 10);
		var vPrice = objDs.getColumn(i, "UNIT_PRICE");
		objDs.setColumn(i, "DATE_TEXT" , this.fn_formatDateTime(objDs.getColumn(i, "MOVEMENT_DATE")));
		objDs.setColumn(i, "TYPE_NAME" , objDs.getColumn(i, "MOVEMENT_TYPE_NAME"));
		objDs.setColumn(i, "QTY_TEXT"  , (nQty > 0 ? "+" : "") + nQty);
		objDs.setColumn(i, "PRICE_TEXT", this.gfn_isNull(vPrice) ? "-" : "₹" + this.gfn_appendComma(vPrice, 2));
	}
	objDs.set_enableevent(true);

	this.fn_copyMovement(this.ds_purchase, "PURCHASE"  , this.div_purchase.form);
	this.fn_copyMovement(this.ds_adjust  , "ADJUSTMENT", this.div_adjust.form);
	this.div_history.form.sta_nodata.set_visible(objDs.rowcount == 0);
};

this.fn_copyMovement = function(objTarget, sType, oPage)
{
	objTarget.copyData(this.ds_movement);
	objTarget.filter("MOVEMENT_TYPE=='" + sType + "'");
	oPage.sta_nodata.set_visible(objTarget.rowcount == 0);
};

// Overview / Purchases / Adjustments / History tabs
this.btn_tab_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var arrTab = [[this.btn_tab_overview, this.div_overview], [this.btn_tab_purchase, this.div_purchase],
	              [this.btn_tab_adjust  , this.div_adjust  ], [this.btn_tab_history , this.div_history ]];
	for(var i=0; i<arrTab.length; i++){
		var bActive = arrTab[i][0] == obj;
		arrTab[i][0].set_color(bActive ? "#1a5fd9" : "#5d6679");
		arrTab[i][0].set_font((bActive ? "600 " : "") + "14px \"Segoe UI\"");
		arrTab[i][1].set_visible(bActive);
	}
	// the blue line under the selected tab
	this.sta_tab_mark.set_left(obj.getOffsetLeft());
	this.sta_tab_mark.set_width(obj.getOffsetWidth());
	this.fv_oTab = obj;
};

// Edit Button
this.btn_edit_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var objChild = new ChildFrame("popEditProduct", 0, 0, 480, 696);
	objChild.formurl = "Base::Form_NewProduct.xfdl";
	objChild.openalign = "center middle";
	objChild.dragmovetype = "all";
	objChild.overlaycolor = "RGBA(0, 0, 0, 0.2)";
	objChild.set_showtitlebar(false);

    objChild.showModal(this.getOwnerFrame()
                     , {pProductId:this.ds_cond.getColumn(0, "PRODUCT_ID")}
                     , this
                     , "fn_callbackPopup");
};

this.fn_callbackPopup = function(sPopupId, sReturn)
{
	if(sReturn == undefined){
		sReturn = "";
	}

	if(sPopupId == "popEditProduct"){
		if(sReturn.length > 0){
			this.gfn_alert("msg.kanban.product.updated", [sReturn]);
			this.fn_searchDetail();
		}
	}
};

// Download Button: the product as CSV (product/export with its Product ID)
this.btn_download_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var sCode = this.gfn_nvl(this.ds_product.getColumn(0, "PRODUCT_CODE"), "");
	system.execBrowser(nexacro.getEnvironment().services["KanbanUrl"].url + "product/export?KEYWORD=" + encodeURIComponent(sCode));
};

// Back to Inventory Button
this.btn_back_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var oLayout = this.parent.parent;
	if(oLayout && oLayout.fn_openMenu){
		oLayout.fn_openMenu("inventory", "Inventory");
	}
};
]]></Script>
  </Form>
</FDL>
