<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_NewProduct" width="480" height="696" titletext="New Product" background="#ffffff" onload="Form_onload" ondrop="Form_ondrop">
    <Layouts>
      <Layout height="696" width="480">
        <Static id="sta_title" taborder="20" text="New Product" left="24" top="16" width="300" height="36" color="#383e49" font="600 20px &quot;Segoe UI&quot;"/>
        <Static id="sta_line_top" taborder="21" left="0" top="60" right="0" height="1" background="#f0f1f3"/>
        <Static id="sta_drop" taborder="22" left="24" top="72" width="432" height="96" background="#f9fafb" border="1px dashed #d0d5dd" borderRadius="8px"/>
        <ImageViewer id="img_photo" taborder="23" left="44" top="84" width="72" height="72" stretch="fixaspectratio" border="1px dashed #98a2b3" borderRadius="8px" background="#ffffff"/>
        <Static id="sta_drag" taborder="24" text="Drag image here" left="136" top="90" width="300" height="22" color="#667085" font="14px &quot;Segoe UI&quot;"/>
        <Static id="sta_or" taborder="25" text="or" left="136" top="110" width="20" height="22" color="#858d9d" font="13px &quot;Segoe UI&quot;"/>
        <Static id="sta_browse" taborder="0" text="Browse image" left="156" top="110" width="110" height="22" color="#1a5fd9" font="600 13px &quot;Segoe UI&quot;" cursor="pointer" onclick="sta_browse_onclick"/>
        <Static id="sta_l_name" taborder="27" text="Product Name" left="24" top="180" width="130" height="38" color="#48505e" font="600 13px &quot;Segoe UI&quot;"/>
        <Edit id="edt_name" taborder="1" left="160" top="180" width="296" height="38" maxlength="100" displaynulltext="Enter product name" borderRadius="8px" border="1px solid #d0d5dd" padding="0px 12px" font="14px &quot;Segoe UI&quot;"/>
        <Static id="sta_l_code" taborder="29" text="Product ID" left="24" top="234" width="130" height="38" color="#48505e" font="600 13px &quot;Segoe UI&quot;"/>
        <Edit id="edt_code" taborder="2" left="160" top="234" width="296" height="38" maxlength="30" displaynulltext="Enter product ID" borderRadius="8px" border="1px solid #d0d5dd" padding="0px 12px" font="14px &quot;Segoe UI&quot;"/>
        <Static id="sta_l_category" taborder="31" text="Category" left="24" top="288" width="130" height="38" color="#48505e" font="600 13px &quot;Segoe UI&quot;"/>
        <Combo id="cmb_category" taborder="3" innerdataset="ds_category" codecolumn="CODE" datacolumn="CODE_NAME" left="160" top="288" width="296" height="38" displaynulltext="Select product category" borderRadius="8px" border="1px solid #d0d5dd" font="14px &quot;Segoe UI&quot;"/>
        <Static id="sta_l_price" taborder="33" text="Buying Price" left="24" top="342" width="130" height="38" color="#48505e" font="600 13px &quot;Segoe UI&quot;"/>
        <Edit id="edt_price" taborder="4" left="160" top="342" width="296" height="38" maxlength="12" inputtype="number" displaynulltext="Enter buying price" borderRadius="8px" border="1px solid #d0d5dd" padding="0px 12px" font="14px &quot;Segoe UI&quot;"/>
        <Static id="sta_l_quantity" taborder="35" text="Quantity" left="24" top="396" width="130" height="38" color="#48505e" font="600 13px &quot;Segoe UI&quot;"/>
        <Edit id="edt_quantity" taborder="5" left="160" top="396" width="296" height="38" maxlength="9" inputtype="digit" displaynulltext="Enter product quantity" borderRadius="8px" border="1px solid #d0d5dd" padding="0px 12px" font="14px &quot;Segoe UI&quot;"/>
        <Static id="sta_l_unit" taborder="37" text="Unit" left="24" top="450" width="130" height="38" color="#48505e" font="600 13px &quot;Segoe UI&quot;"/>
        <Edit id="edt_unit" taborder="6" left="160" top="450" width="296" height="38" maxlength="20" displaynulltext="Enter product unit" borderRadius="8px" border="1px solid #d0d5dd" padding="0px 12px" font="14px &quot;Segoe UI&quot;"/>
        <Static id="sta_l_expiry" taborder="39" text="Expiry Date" left="24" top="504" width="130" height="38" color="#48505e" font="600 13px &quot;Segoe UI&quot;"/>
        <Calendar id="cal_expiry" taborder="7" left="160" top="504" width="296" height="38" dateformat="dd/MM/yyyy" displaynulltext="Enter expiry date" borderRadius="8px" border="1px solid #d0d5dd" font="14px &quot;Segoe UI&quot;"/>
        <Static id="sta_l_threshold" taborder="41" text="Threshold Value" left="24" top="558" width="130" height="38" color="#48505e" font="600 13px &quot;Segoe UI&quot;"/>
        <Edit id="edt_threshold" taborder="8" left="160" top="558" width="296" height="38" maxlength="9" inputtype="digit" displaynulltext="Enter threshold value" borderRadius="8px" border="1px solid #d0d5dd" padding="0px 12px" font="14px &quot;Segoe UI&quot;"/>
        <Static id="sta_line_bottom" taborder="43" left="0" top="626" right="0" height="1" background="#f0f1f3"/>
        <Button id="btn_discard" taborder="9" text="Discard" left="240" top="640" width="88" height="40" background="#ffffff" color="#5d6679" borderRadius="8px" border="1px solid #d0d5dd" font="600 13px &quot;Segoe UI&quot;" onclick="btn_discard_onclick"/>
        <Button id="btn_save" taborder="10" text="Add Product" left="336" top="640" width="120" height="40" background="#1a5fd9" color="#ffffff" borderRadius="8px" border="0px none" font="600 13px &quot;Segoe UI&quot;" onclick="btn_save_onclick"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_product">
        <ColumnInfo>
          <Column id="PRODUCT_ID" type="STRING" size="20"/>
          <Column id="PRODUCT_NAME" type="STRING" size="100"/>
          <Column id="PRODUCT_CODE" type="STRING" size="30"/>
          <Column id="CATEGORY_CODE" type="STRING" size="30"/>
          <Column id="BUYING_PRICE" type="STRING" size="15"/>
          <Column id="QUANTITY" type="STRING" size="10"/>
          <Column id="UNIT" type="STRING" size="20"/>
          <Column id="EXPIRY_DATE" type="STRING" size="8"/>
          <Column id="THRESHOLD_VALUE" type="STRING" size="10"/>
          <Column id="IMAGE_DATA" type="STRING" size="2000000"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="ds_result"/>
      <Dataset id="ds_detail"/>
      <Dataset id="ds_cond">
        <ColumnInfo>
          <Column id="PRODUCT_ID" type="STRING" size="20"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="ds_codeCond">
        <ColumnInfo>
          <Column id="GROUP_CODES" type="STRING" size="200"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="ds_code"/>
      <Dataset id="ds_category">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="30"/>
          <Column id="CODE_NAME" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
      <FileDialog id="fdl_image" filter="Images(*.png;*.jpg;*.jpeg;*.gif)|*.png;*.jpg;*.jpeg;*.gif|" onclose="fdl_image_onclose"/>
      <FileUpTransfer id="fut_image" onsuccess="fut_image_onsuccess" onerror="fut_image_onerror"/>
    </Objects>
    <Bind>
      <BindItem id="bind_name" compid="edt_name" propid="value" datasetid="ds_product" columnid="PRODUCT_NAME"/>
      <BindItem id="bind_code" compid="edt_code" propid="value" datasetid="ds_product" columnid="PRODUCT_CODE"/>
      <BindItem id="bind_category" compid="cmb_category" propid="value" datasetid="ds_product" columnid="CATEGORY_CODE"/>
      <BindItem id="bind_price" compid="edt_price" propid="value" datasetid="ds_product" columnid="BUYING_PRICE"/>
      <BindItem id="bind_quantity" compid="edt_quantity" propid="value" datasetid="ds_product" columnid="QUANTITY"/>
      <BindItem id="bind_unit" compid="edt_unit" propid="value" datasetid="ds_product" columnid="UNIT"/>
      <BindItem id="bind_expiry" compid="cal_expiry" propid="value" datasetid="ds_product" columnid="EXPIRY_DATE"/>
      <BindItem id="bind_threshold" compid="edt_threshold" propid="value" datasetid="ds_product" columnid="THRESHOLD_VALUE"/>
    </Bind>
    <Script type="xscript5.1"><![CDATA[include "Lib::Lib_Comm.xjs";

this.fv_sProductId = "";

this.Form_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	// edit mode: Form_ProductInfo opens this popup with {pProductId}
	this.fv_sProductId = this.gfn_nvl(this.getOwnerFrame().pProductId, "");
	if(this.fn_isEdit()){
		this.sta_title.set_text("Edit Product");
		this.btn_save.set_text("Save Changes");
		// the quantity changes with stock movements, not here
		this.edt_quantity.set_readonly(true);
		this.edt_quantity.set_background("#f2f4f7");
	}
	this.fn_searchCode();
	this.edt_name.setFocus();
};

this.fn_isEdit = function()
{
	return this.fv_sProductId != "";
};

// the product to edit (product/detail), after the category codes are loaded
this.fn_searchDetail = function()
{
	this.ds_cond.setColumn(0, "PRODUCT_ID", this.fv_sProductId);

    var sSvcID    = "svcProductDetail";
    var sURL      = "KanbanUrl::product/detail";
    var sInDs     = "ds_cond=ds_cond";
    var sOutDs    = "ds_detail=ds_product";
    var sParam    = "";
    var sCallBack = "fn_callback";
	this.gfn_transaction(sSvcID, sURL, sInDs, sOutDs, sParam, sCallBack);
};

// copies the detail into the bound one-row ds_product
this.fn_setDetail = function()
{
	for(var i=0; i<this.ds_product.getColCount(); i++){
		var sColId = this.ds_product.getColID(i);
		this.ds_product.setColumn(0, sColId, this.ds_detail.getColumn(0, sColId));
	}
	// 257.00 -> 257
	this.ds_product.setColumn(0, "BUYING_PRICE", String(Number(this.ds_detail.getColumn(0, "BUYING_PRICE"))));

	var sImage = this.ds_detail.getColumn(0, "IMAGE_DATA");
	if(!this.gfn_isNull(sImage)){
		this.img_photo.set_image("url('" + nexacro.getEnvironment().services["KanbanUrl"].url + sImage + "')");
	}
};

// common codes of the Category combo
this.fn_searchCode = function()
{
	this.ds_codeCond.setColumn(0, "GROUP_CODES", "CATEGORY");

    var sSvcID    = "svcCommonCode";
    var sURL      = "KanbanUrl::common/code";
    var sInDs     = "ds_cond=ds_codeCond";
    var sOutDs    = "ds_code=ds_code";
    var sParam    = "";
    var sCallBack = "fn_callback";
	this.gfn_transaction(sSvcID, sURL, sInDs, sOutDs, sParam, sCallBack);
};

this.fn_callback = function(svcId, errCd, errMsg)
{
	if(errCd < 0){
		this.btn_save.set_enable(true);
		this.gfn_alert("msg.err.validator", [errMsg]);
		return;
	}

	if(svcId == "svcCommonCode"){
		var arrCode = new Array();
		arrCode.push({codeGroup:"CATEGORY", obj:this.cmb_category, first:"2::Select product category"});
		this.gfn_getCommonCode(arrCode, this.ds_code);

		if(this.fn_isEdit()){
			this.fn_searchDetail();
		}
	}
	else if(svcId == "svcProductDetail"){
		this.fn_setDetail();
	}
	else if(svcId == "svcSaveProduct" || svcId == "svcUpdateProduct"){
		this.close(this.ds_product.getColumn(0, "PRODUCT_NAME"));
	}
};

// Browse image Link
this.sta_browse_onclick = function(obj:nexacro.Static,e:nexacro.ClickEventInfo)
{
	this.fdl_image.open("Select image", FileDialog.LOAD);
};

this.fdl_image_onclose = function(obj:nexacro.FileDialog,e:nexacro.FileDialogEventInfo)
{
	if(e.virtualfiles && e.virtualfiles.length > 0){
		this.fn_uploadImage(e.virtualfiles[0]);
	}
};

// Drag image here
this.Form_ondrop = function(obj:nexacro.Form,e:nexacro.DragEventInfo)
{
	if(e.filelist && e.filelist.length > 0){
		this.fn_uploadImage(e.filelist[0]);
	}
	
};

// uploads the image to file/upload (FileUpTransfer works in Nexacro Runtime and in a browser)
this.fn_uploadImage = function(objFile)
{
	if(!/\.(png|jpe?g|gif)$/i.test(objFile.filename)){
		this.gfn_alert("msg.kanban.image.type");
		return;
	}
	// Save waits for the upload
	this.btn_save.set_enable(false);
	this.fut_image.clearFileList();
	this.fut_image.addFile(objFile.filename, objFile);
	this.fut_image.upload("KanbanUrl::file/upload");
};

this.fut_image_onsuccess = function(obj:nexacro.FileUpTransfer,e:nexacro.FileUpTransferEventInfo)
{
	this.btn_save.set_enable(true);

	// ds_file (FILE_PATH = "file/<name>")
	var sPath = "";
	var arrDs = e.datasets || [];
	for(var i=0; i<arrDs.length; i++){
		if(arrDs[i] && arrDs[i].getColIndex("FILE_PATH") > -1 && arrDs[i].rowcount > 0){
			sPath = arrDs[i].getColumn(0, "FILE_PATH");
		}
	}
	if(this.gfn_isNull(sPath)){
		this.gfn_alert("msg.kanban.image.read");
		return;
	}
	this.ds_product.setColumn(0, "IMAGE_DATA", sPath);
	this.img_photo.set_image("url('" + nexacro.getEnvironment().services["KanbanUrl"].url + sPath + "')");
};

this.fut_image_onerror = function(obj:nexacro.FileUpTransfer,e:nexacro.FileUpTransferErrorEventInfo)
{
	this.btn_save.set_enable(true);
	this.gfn_alert("msg.err.validator", [e.errormsg]);
};

// Add Product / Save Changes Button
this.btn_save_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.gfn_clearValidation(this.ds_product);
	this.gfn_setValidation(this.ds_product, "PRODUCT_NAME"   , "Product name"   , "required");
	this.gfn_setValidation(this.ds_product, "PRODUCT_CODE"   , "Product ID"     , "required");
	this.gfn_setValidation(this.ds_product, "CATEGORY_CODE"  , "Category"       , "required");
	this.gfn_setValidation(this.ds_product, "BUYING_PRICE"   , "Buying price"   , "required,min:0");
	this.gfn_setValidation(this.ds_product, "QUANTITY"       , "Quantity"       , "required,digits");
	this.gfn_setValidation(this.ds_product, "UNIT"           , "Unit"           , "required");
	this.gfn_setValidation(this.ds_product, "EXPIRY_DATE"    , "Expiry date"    , "required,date");
	this.gfn_setValidation(this.ds_product, "THRESHOLD_VALUE", "Threshold value", "required,digits");
	if(this.gfn_validation(this.ds_product, "A") == false) return;

	this.btn_save.set_enable(false);

    var sSvcID    = this.fn_isEdit() ? "svcUpdateProduct" : "svcSaveProduct";
    var sURL      = this.fn_isEdit() ? "KanbanUrl::product/update" : "KanbanUrl::product/insert";
    var sInDs     = "ds_product=ds_product";
    var sOutDs    = this.fn_isEdit() ? "" : "ds_result=ds_result";
    var sParam    = "";
    var sCallBack = "fn_callback";
	this.gfn_transaction(sSvcID, sURL, sInDs, sOutDs, sParam, sCallBack);
};

// Discard Button
this.btn_discard_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.close();
};
]]></Script>
  </Form>
</FDL>
