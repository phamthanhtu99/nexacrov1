<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_Inventory" width="1050" height="648" titletext="Inventory" background="#f0f1f3" onload="Form_onload">
    <Layouts>
      <Layout height="648" width="1050">
        <Div id="div_summary" taborder="37" left="24" top="16" right="24" height="130" background="#ffffff" borderRadius="8px" border="0px none">
          <Layouts>
            <Layout>
              <Static id="sta_title" taborder="0" text="Overall Inventory" left="16" top="12" width="300" height="30" color="#383e49" font="600 18px &quot;Segoe UI&quot;"/>
              <Div id="div_categories" taborder="1" left="0" top="48" width="25%" height="72" border="0px none">
                <Layouts>
                  <Layout>
                    <Static id="sta_label" taborder="0" text="Categories" left="16" top="0" width="150" height="22" color="#1570ef" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_value" taborder="1" text="-" left="16" top="24" width="100" height="24" color="#5d6679" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_note" taborder="2" text="In use" left="16" top="50" width="100" height="20" color="#858d9d" font="12px &quot;Segoe UI&quot;"/>
                  </Layout>
                </Layouts>
              </Div>
              <Div id="div_total" taborder="2" left="25%" top="48" width="25%" height="72" border="0px none">
                <Layouts>
                  <Layout>
                    <Static id="sta_divider" taborder="0" left="0" top="4" width="1" height="62" background="#f0f1f3"/>
                    <Static id="sta_label" taborder="1" text="Total Products" left="16" top="0" width="150" height="22" color="#e19133" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_value" taborder="2" text="-" left="16" top="24" width="90" height="24" color="#5d6679" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_note" taborder="3" text="All items" left="16" top="50" width="90" height="20" color="#858d9d" font="12px &quot;Segoe UI&quot;"/>
                    <Static id="sta_value2" taborder="4" text="-" right="16" top="24" width="110" height="24" textAlign="right" color="#5d6679" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_note2" taborder="5" text="Revenue, 7 days" right="16" top="50" width="110" height="20" textAlign="right" color="#858d9d" font="12px &quot;Segoe UI&quot;"/>
                  </Layout>
                </Layouts>
              </Div>
              <Div id="div_top" taborder="3" left="50%" top="48" width="25%" height="72" border="0px none">
                <Layouts>
                  <Layout>
                    <Static id="sta_divider" taborder="0" left="0" top="4" width="1" height="62" background="#f0f1f3"/>
                    <Static id="sta_label" taborder="1" text="Top Selling" left="16" top="0" width="150" height="22" color="#845ebc" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_value" taborder="2" text="-" left="16" top="24" width="90" height="24" color="#5d6679" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_note" taborder="3" text="Last 7 days" left="16" top="50" width="90" height="20" color="#858d9d" font="12px &quot;Segoe UI&quot;"/>
                    <Static id="sta_value2" taborder="4" text="-" right="16" top="24" width="110" height="24" textAlign="right" color="#5d6679" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_note2" taborder="5" text="Cost" right="16" top="50" width="110" height="20" textAlign="right" color="#858d9d" font="12px &quot;Segoe UI&quot;"/>
                  </Layout>
                </Layouts>
              </Div>
              <Div id="div_low" taborder="4" left="75%" top="48" width="25%" height="72" border="0px none">
                <Layouts>
                  <Layout>
                    <Static id="sta_divider" taborder="0" left="0" top="4" width="1" height="62" background="#f0f1f3"/>
                    <Static id="sta_label" taborder="1" text="Low Stocks" left="16" top="0" width="150" height="22" color="#f36960" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_value" taborder="2" text="-" left="16" top="24" width="90" height="24" color="#5d6679" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_note" taborder="3" text="Low stock" left="16" top="50" width="90" height="20" color="#858d9d" font="12px &quot;Segoe UI&quot;"/>
                    <Static id="sta_value2" taborder="4" text="-" right="16" top="24" width="110" height="24" textAlign="right" color="#5d6679" font="600 14px &quot;Segoe UI&quot;"/>
                    <Static id="sta_note2" taborder="5" text="Not in stock" right="16" top="50" width="110" height="20" textAlign="right" color="#858d9d" font="12px &quot;Segoe UI&quot;"/>
                  </Layout>
                </Layouts>
              </Div>
            </Layout>
          </Layouts>
        </Div>
        <Static id="sta_product_bg" taborder="38" left="24" top="162" right="24" bottom="16" background="#ffffff" borderRadius="8px"/>
        <Static id="sta_products" taborder="39" text="Products" left="40" top="176" width="200" height="36" color="#383e49" font="600 18px &quot;Segoe UI&quot;"/>
        <Static id="sta_filter_info" taborder="41" left="150" top="176" width="300" height="36" color="#1a5fd9" font="12px &quot;Segoe UI&quot;"/>
        <Button id="btn_add" taborder="1" text="Add Product" right="240" top="176" width="96" height="36" background="#1a5fd9" color="#ffffff" borderRadius="4px" border="0px none" font="600 13px &quot;Segoe UI&quot;" onclick="btn_add_onclick"/>
        <Button id="btn_filter" taborder="2" text="Filters" right="146" top="176" width="84" height="36" icon="url('imagerc::kanban/ic_filter.png')" textPadding="0px 0px 0px 6px" background="#ffffff" color="#5d6679" borderRadius="4px" border="1px solid #d0d3d9" font="13px &quot;Segoe UI&quot;" onclick="btn_filter_onclick"/>
        <Button id="btn_download" taborder="3" text="Download all" right="40" top="176" width="96" height="36" background="#ffffff" color="#5d6679" borderRadius="4px" border="1px solid #d0d3d9" font="13px &quot;Segoe UI&quot;" onclick="btn_download_onclick"/>
        <Grid id="grd_product" taborder="4" left="40" top="218" right="40" bottom="74" binddataset="ds_product" autofittype="col" border="0px none" selecttype="row" cursor="pointer" oncellclick="grd_product_oncellclick">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="180"/>
                <Column size="150"/>
                <Column size="150"/>
                <Column size="160"/>
                <Column size="140"/>
                <Column size="130"/>
              </Columns>
              <Rows>
                <Row size="34" band="head"/>
                <Row size="34"/>
              </Rows>
              <Band id="head">
                <Cell text="Products" textAlign="left" background="#ffffff" color="#667085" font="600 13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                <Cell col="1" text="Buying Price" textAlign="left" background="#ffffff" color="#667085" font="600 13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                <Cell col="2" text="Quantity" textAlign="left" background="#ffffff" color="#667085" font="600 13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                <Cell col="3" text="Threshold Value" textAlign="left" background="#ffffff" color="#667085" font="600 13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                <Cell col="4" text="Expiry Date" textAlign="left" background="#ffffff" color="#667085" font="600 13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                <Cell col="5" text="Availability" textAlign="left" background="#ffffff" color="#667085" font="600 13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
              </Band>
              <Band id="body">
                <Cell text="bind:PRODUCT_NAME" textAlign="left" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                <Cell col="1" text="expr:'₹' + comp.parent.gfn_appendComma(BUYING_PRICE)" textAlign="left" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                <Cell col="2" text="expr:QUANTITY + ' ' + UNIT" textAlign="left" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                <Cell col="3" text="expr:THRESHOLD_VALUE + ' ' + UNIT" textAlign="left" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                <Cell col="4" text="expr:comp.parent.fn_formatDate(EXPIRY_DATE)" textAlign="left" color="#48505e" font="13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
                <Cell col="5" text="bind:AVAILABILITY_NAME" textAlign="left" cssclass="expr:AVAILABILITY=='IN'?'cell_WF_StockIn':(AVAILABILITY=='LOW'?'cell_WF_StockLow':'cell_WF_StockOut')" font="13px &quot;Segoe UI&quot;" padding="0px 4px 0px 0px" border="0px none, 0px none, 1px solid #f0f1f3, 0px none"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Static id="sta_nodata" taborder="42" visible="false" text="No products match your search." left="40" top="290" right="40" height="40" textAlign="center" color="#858d9d" font="14px &quot;Segoe UI&quot;"/>
        <Button id="btn_prev" taborder="5" text="Previous" left="40" bottom="28" width="76" height="36" background="#ffffff" color="#5d6679" borderRadius="4px" border="1px solid #d0d3d9" font="13px &quot;Segoe UI&quot;" onclick="btn_prev_onclick"/>
        <Static id="sta_page" taborder="40" left="126" right="126" bottom="28" height="36" textAlign="center" color="#48505e" font="13px &quot;Segoe UI&quot;"/>
        <Button id="btn_next" taborder="6" text="Next" right="40" bottom="28" width="76" height="36" background="#ffffff" color="#5d6679" borderRadius="4px" border="1px solid #d0d3d9" font="13px &quot;Segoe UI&quot;" onclick="btn_next_onclick"/>
        <PopupDiv id="pdv_filter" visible="false" left="0" top="0" width="260" height="210" background="#ffffff" border="1px solid #e4e7ec" borderRadius="8px">
          <Layouts>
            <Layout>
              <Static id="sta_l_category" taborder="4" text="Category" left="16" top="12" width="228" height="20" color="#48505e" font="600 12px &quot;Segoe UI&quot;"/>
              <Combo id="cmb_category" taborder="0" codecolumn="CODE" datacolumn="CODE_NAME" left="16" top="34" width="228" height="36" borderRadius="6px" border="1px solid #d0d5dd" font="13px &quot;Segoe UI&quot;"/>
              <Static id="sta_l_availability" taborder="5" text="Availability" left="16" top="80" width="228" height="20" color="#48505e" font="600 12px &quot;Segoe UI&quot;"/>
              <Combo id="cmb_availability" taborder="1" codecolumn="CODE" datacolumn="CODE_NAME" left="16" top="102" width="228" height="36" borderRadius="6px" border="1px solid #d0d5dd" font="13px &quot;Segoe UI&quot;"/>
              <Button id="btn_reset" taborder="2" text="Reset" left="16" top="156" width="108" height="36" background="#ffffff" color="#5d6679" borderRadius="6px" border="1px solid #d0d5dd" font="600 13px &quot;Segoe UI&quot;" onclick="pdv_filter_btn_reset_onclick"/>
              <Button id="btn_apply" taborder="3" text="Apply" left="136" top="156" width="108" height="36" background="#1a5fd9" color="#ffffff" borderRadius="6px" border="0px none" font="600 13px &quot;Segoe UI&quot;" onclick="pdv_filter_btn_apply_onclick"/>
            </Layout>
          </Layouts>
        </PopupDiv>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_cond">
        <ColumnInfo>
          <Column id="KEYWORD" type="STRING" size="100"/>
          <Column id="CATEGORY" type="STRING" size="30"/>
          <Column id="AVAILABILITY" type="STRING" size="10"/>
          <Column id="PAGE" type="STRING" size="10"/>
          <Column id="PAGE_SIZE" type="STRING" size="10"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="PAGE">1</Col>
            <Col id="PAGE_SIZE">9</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="ds_product"/>
      <Dataset id="ds_page"/>
      <Dataset id="ds_summary"/>
      <Dataset id="ds_codeCond">
        <ColumnInfo>
          <Column id="GROUP_CODES" type="STRING" size="200"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="ds_code"/>
      <Dataset id="ds_category">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="30"/>
          <Column id="CODE_NAME" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_availability">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="30"/>
          <Column id="CODE_NAME" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[include "Lib::Lib_Comm.xjs";

this.CONST_PAGE_SIZE = 9;
this.fv_nPage = 1;

this.Form_onload = function(obj:nexacro.Form,e:nexacro.LoadEventInfo)
{
	var oFilter = this.pdv_filter.form;
	oFilter.cmb_category.set_innerdataset(this.ds_category);
	oFilter.cmb_availability.set_innerdataset(this.ds_availability);

	this.fn_searchCode();
};

// common codes of the filter combos
this.fn_searchCode = function()
{
	this.ds_codeCond.setColumn(0, "GROUP_CODES", "CATEGORY,AVAILABILITY");

    var sSvcID    = "svcCommonCode";
    var sURL      = "KanbanUrl::common/code";
    var sInDs     = "ds_cond=ds_codeCond";
    var sOutDs    = "ds_code=ds_code";
    var sParam    = "";
    var sCallBack = "fn_callback";
	this.gfn_transaction(sSvcID, sURL, sInDs, sOutDs, sParam, sCallBack);
};

// Overall Inventory
this.fn_searchSummary = function()
{
    var sSvcID    = "svcSummary";
    var sURL      = "KanbanUrl::product/summary";
    var sInDs     = "";
    var sOutDs    = "ds_summary=ds_summary";
    var sParam    = "";
    var sCallBack = "fn_callback";
	this.gfn_transaction(sSvcID, sURL, sInDs, sOutDs, sParam, sCallBack);
};

// one page of products (paged on the server)
this.fn_searchList = function(nPage)
{
	this.fv_nPage = nPage;
	this.ds_cond.setColumn(0, "PAGE"     , nPage);
	this.ds_cond.setColumn(0, "PAGE_SIZE", this.CONST_PAGE_SIZE);
	// the server sends no dataset when nothing matches, so clear it first
	this.ds_product.clearData();

    var sSvcID    = "svcProductList";
    var sURL      = "KanbanUrl::product/list";
    var sInDs     = "ds_cond=ds_cond";
    var sOutDs    = "ds_product=ds_product ds_page=ds_page";
    var sParam    = "";
    var sCallBack = "fn_callback";
	this.gfn_transaction(sSvcID, sURL, sInDs, sOutDs, sParam, sCallBack);
};

this.fn_callback = function(svcId, errCd, errMsg)
{
	if(errCd < 0){
		this.gfn_alert("msg.err.validator", [errMsg]);
		return;
	}

	if(svcId == "svcCommonCode"){
		var arrCode = new Array();
		arrCode.push({codeGroup:"CATEGORY"    , obj:this.pdv_filter.form.cmb_category    , first:"2::All categories"});
		arrCode.push({codeGroup:"AVAILABILITY", obj:this.pdv_filter.form.cmb_availability, first:"2::All"});
		this.gfn_getCommonCode(arrCode, this.ds_code);

		this.fn_searchSummary();
		this.fn_searchList(1);
	}
	else if(svcId == "svcSummary"){
		this.fn_showSummary();
	}
	else if(svcId == "svcProductList"){
		var nTotal = this.ds_page.rowcount > 0 ? parseInt(this.ds_page.getColumn(0, "TOTAL_COUNT"), 10) : 0;
		this.fn_setPaging(nTotal);
		this.sta_nodata.set_visible(nTotal == 0);
		this.ds_product.set_rowposition(-1);
	}
};

this.fn_showSummary = function()
{
	var objDs = this.ds_summary;
	var oForm = this.div_summary.form;
	oForm.div_categories.form.sta_value.set_text(objDs.getColumn(0, "CATEGORY_COUNT"));
	oForm.div_total.form.sta_value.set_text(objDs.getColumn(0, "PRODUCT_COUNT"));
	oForm.div_total.form.sta_value2.set_text("₹" + this.gfn_appendComma(objDs.getColumn(0, "REVENUE")));
	oForm.div_top.form.sta_value.set_text(objDs.getColumn(0, "TOP_SELLING"));
	oForm.div_top.form.sta_value2.set_text("₹" + this.gfn_appendComma(objDs.getColumn(0, "TOP_SELLING_COST")));
	oForm.div_low.form.sta_value.set_text(objDs.getColumn(0, "LOW_STOCK"));
	oForm.div_low.form.sta_value2.set_text(objDs.getColumn(0, "OUT_OF_STOCK"));
};

this.fn_setPaging = function(nTotal)
{
	var nTotalPage = Math.max(1, Math.ceil(nTotal / this.CONST_PAGE_SIZE));
	this.sta_page.set_text("Page " + this.fv_nPage + " of " + nTotalPage);
	this.btn_prev.set_enable(this.fv_nPage > 1);
	this.btn_next.set_enable(this.fv_nPage < nTotalPage);
};

// yyyyMMdd -> dd/MM/yy (used by the Expiry Date cell)
this.fn_formatDate = function(sDate)
{
	if(this.gfn_isNull(sDate) || String(sDate).length < 8) return "";
	sDate = String(sDate);
	return sDate.substr(6, 2) + "/" + sDate.substr(4, 2) + "/" + sDate.substr(2, 2);
};

// Called by Form_Layout when the header search changes (already debounced there)
this.fn_search = function(sKeyword)
{
	this.ds_cond.setColumn(0, "KEYWORD", sKeyword);
	this.fn_searchList(1);
};

// Previous Button
this.btn_prev_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.fn_searchList(this.fv_nPage - 1);
};

// Next Button
this.btn_next_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.fn_searchList(this.fv_nPage + 1);
};

// Filters Button
this.btn_filter_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.pdv_filter.trackPopupByComponent(obj, obj.getOffsetWidth() - this.pdv_filter.getOffsetWidth(), obj.getOffsetHeight() + 4);
};

// Apply Button (filter popup)
this.pdv_filter_btn_apply_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var oFilter = this.pdv_filter.form;
	this.ds_cond.setColumn(0, "CATEGORY"    , oFilter.cmb_category.value);
	this.ds_cond.setColumn(0, "AVAILABILITY", oFilter.cmb_availability.value);
	this.pdv_filter.closePopup();

	var arrText = new Array();
	if(!this.gfn_isNull(oFilter.cmb_category.value))     arrText.push(oFilter.cmb_category.text);
	if(!this.gfn_isNull(oFilter.cmb_availability.value)) arrText.push(oFilter.cmb_availability.text);
	this.sta_filter_info.set_text(arrText.length > 0 ? "Filtered: " + arrText.join(", ") : "");

	this.fn_searchList(1);
};

// Reset Button (filter popup)
this.pdv_filter_btn_reset_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.pdv_filter.form.cmb_category.set_index(0);
	this.pdv_filter.form.cmb_availability.set_index(0);
	this.pdv_filter_btn_apply_onclick(obj, e);
};

// Product row -> Product Info
this.grd_product_oncellclick = function(obj:nexacro.Grid,e:nexacro.GridClickEventInfo)
{
	var oLayout = this.parent.parent;
	if(e.row > -1 && oLayout && oLayout.fn_openProduct){
		oLayout.fn_openProduct(this.ds_product.getColumn(e.row, "PRODUCT_ID"));
	}
};

// Add Product Button
this.btn_add_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var objChild = new ChildFrame("popNewProduct", 0, 0, 480, 696);
	objChild.formurl = "Base::Form_NewProduct.xfdl";
	objChild.openalign = "center middle";
	objChild.dragmovetype = "all";
	objChild.overlaycolor = "RGBA(0, 0, 0, 0.2)";
	objChild.set_showtitlebar(false);

    objChild.showModal(this.getOwnerFrame()
                     , {}
                     , this
                     , "fn_callbackPopup");
};

this.fn_callbackPopup = function(sPopupId, sReturn)
{
	if(sReturn == undefined){
		sReturn = "";
	}

	if(sPopupId == "popNewProduct"){
		if(sReturn.length > 0){
			this.gfn_alert("msg.kanban.product.added", [sReturn]);
			// refresh after insert: the new product is the first row of page 1
			this.fn_searchSummary();
			this.fn_searchList(1);
		}
	}
};

// Download all Button
this.btn_download_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	var sQuery = "?KEYWORD="      + encodeURIComponent(this.gfn_nvl(this.ds_cond.getColumn(0, "KEYWORD"), ""))
	           + "&CATEGORY="     + encodeURIComponent(this.gfn_nvl(this.ds_cond.getColumn(0, "CATEGORY"), ""))
	           + "&AVAILABILITY=" + encodeURIComponent(this.gfn_nvl(this.ds_cond.getColumn(0, "AVAILABILITY"), ""));
	system.execBrowser(nexacro.getEnvironment().services["KanbanUrl"].url + "product/export" + sQuery);
};
]]></Script>
  </Form>
</FDL>
